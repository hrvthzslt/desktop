#!/bin/sh

get_external_displays() {
  if ! xrandr --query 2>/dev/null |
    awk '$2 == "connected" && $1 !~ /^(eDP|LVDS|DSI)/ {found=1} END {exit !found}'; then
    return
  fi

  ddcutil detect 2>/dev/null | awk '/^Display/ {print $2}' | sort -u
}

main() {
  displays=$(get_external_displays)

  case $1 in
    inc)
      increase_brightness
      exit 0
      ;;
    dec)
      decrease_brightness
      exit 0
      ;;
    *)
      help
      exit 1
      ;;
  esac
}

change_brightness() {
  # Internal display
  brightnessctl set 5%"$1"

  # External displays
  for disp in $displays; do
    ddcutil --display "$disp" setvcp 10 "$1" 5
  done
}

increase_brightness() {
  change_brightness + && progress_bar
}

decrease_brightness() {
  change_brightness - && progress_bar
}

progress_bar() {
  notify-send "Brightness" -h string:x-dunst-stack-tag:brightness -h int:value:"$(get_brightness_percentage)"
}

get_brightness_percentage() {
  if [ -z "$displays" ]; then
    percentage=$(brightnessctl -m | awk -F, '{gsub(/%/, "", $4); print $4; exit}')
  else
    display=$(printf '%s\n' "$displays" | awk 'NR == 1 {print; exit}')
    percentage=$(ddcutil --display "$display" getvcp 10 2>/dev/null |
      awk -F'[=,]' '/current value/ {print $2 * 100 / $4; exit}')
  fi

  echo "$percentage"
}

help() {
  echo "Usage: brightness [inc|dec]"
  echo "  inc       increase brightness"
  echo "  dec       decrease brightness"
}

main "$1"
