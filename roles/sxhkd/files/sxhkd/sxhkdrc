XF86AudioRaiseVolume
    volume inc ; pkill -RTMIN+14 dwmblocks

XF86AudioLowerVolume
    volume dec ; pkill -RTMIN+14 dwmblocks

XF86AudioMute
    volume toggle ; pkill -RTMIN+14 dwmblocks

XF86MonBrightnessUp
    brightness inc

XF86MonBrightnessDown
    brightness dec

Print
    flameshot gui

super + Escape
    slock

super + shift + s
    slock & systemctl suspend

super + shift + d
    sysp

super + r
    autorandr --change --force && nitrogen --restore

super + n
    alacritty --title nmtui --command nmtui

super + u
    alacritty --title bluetuith --command bluetuith

super + shift + n
    alacritty --title ncdu --command ncdu "$HOME"

super + s
    arandr

super + v
    pavucontrol

super + o
    thunar

super + shift + p
    clipmenu -nb '#1C1917' -nf '#CFC1BA' -sb '#2C363C' -sf '#F0EDEC'

super + c
    clipboard toggle ; pkill -RTMIN+10 dwmblocks

super + shift + c
    clipboard clear

super + a
    notification close

super + shift + a
    notification toggle ; pkill -RTMIN+12 dwmblocks

super + w
    thorium-browser

super + e
    pgrep screenkey || screenkey --show-settings

super + shift + e
    pkill screenkey

super + shift + m
    power set ; pkill -RTMIN+16 dwmblocks

super + shift + t
    vpn_control switch ; pkill -RTMIN+20 dwmblocks

super + shift + l
    keemap switch ; pkill -RTMIN+18 dwmblocks
